# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google Gemini API Key (Model strictly locked to gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Comma-separated list of Telegram User IDs who have administrator rights
ADMIN_IDS=123456789,987654321

# Primary Telegram Group Chat ID (where match results and transfer news are posted)
GROUP_CHAT_ID=-1001234567890

# Autopilot interval in hours between rounds (default: 24 hours)
AUTOPILOT_INTERVAL_HOURS=24
